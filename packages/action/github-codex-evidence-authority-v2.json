  "terminal_evidence": {
    "carrier_schema": {
      "required_fields": [
        "channel",
        "created_at",
        "id",
        "outcome"
      ],
      "channel_values": [
        "issue-comment",
        "pull-request-review"
      ],
      "channel_mapping": {
        "terminal_issue_comment": "issue-comment",
        "top_level_review_or_inline_finding_parent_review": "pull-request-review"
      },
      "created_at_type": "strict-utc-server-time",
      "id_type": "canonical-decimal-string",
      "outcome_values": [
        "clean",
        "findings",
        "malformed"
      ]
    },
    "selection_precedence": {
      "semantic_time": "created_at",
      "later_semantic_time_wins": true,
      "equal_time_cross_channel": "inconclusive",
      "equal_time_same_channel_outcome_order": [
        "malformed",
        "findings",
        "clean"
      ],
      "equal_time_same_channel_same_outcome_tiebreaker": "greatest-canonical-decimal-id"
    },
    "clean": {
      "provider_profile": "terminal-payload",
      "decision": "inconclusive",
      "scope_assurance": "artifact-publication-only",
      "provider_input_lineage": "unavailable"
    },
    "findings": {
      "provider_profile": "terminal-payload",
      "decision": "findings",
      "scope_assurance": "artifact-publication-only",
      "provider_input_lineage": "unavailable"
    },
    "mixed": {
      "provider_profile": "mixed",
      "terminal_payload_controls_decision": true,
      "reaction_evidence_role": "audit-only",
      "plus_one_never_overrides_terminal_findings": true,
      "scope_assurance": "artifact-publication-only",
      "provider_input_lineage": "unavailable"
    }
  },
  "reaction_evidence": {
