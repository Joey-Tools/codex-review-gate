    "requires_exact_parent_join": true,
    "requires_reaction_created_strictly_after_request_server_time": true,
    "requires_complete_current_scope_request_and_reaction_pages": true,
    "requires_final_complete_current_scope_reread": true,
    "historical_profile_required": false,
    "historical_samples_required": 0,
    "eyes_is_liveness_only": true,
    "eyes_at_or_after_selected_plus_one_vetoes_reaction_only_clean": true,
    "eyes_never_vetoes_terminal_payload": true,
    "terminal_payload_precedence": true,
    "scope_assurance": "whole-pr-contractual",
    "provider_input_lineage": "unavailable"
  },
  "no_start_rejection": {
    "profile": "no-start-rejection",
    "controlled_request_body": "@codex review",
    "exact_bodies": [
      "To use Codex here, [create an environment for this repo](https://chatgpt.com/codex/cloud/settings/environments).",
      "To use Codex here, [create a Codex account and connect to github](https://chatgpt.com/codex/cloud/settings/connectors)."
    ],
    "requires_controlled_request": true,
    "requires_first_observation_after_controlled_request": true,
    "requires_carrier_created_strictly_after_request_server_time": true,
    "required_server_time_fields": [
      "request_created_at",
      "carrier_created_at",
      "first_observation_server_time",
      "stable_reread_server_time"
    ],
    "requires_first_observation_in_run_different_from_request": true,
    "requires_stable_reread_in_later_run": true,
    "requires_direct_stable_reread": true,
    "minimum_stable_reread_seconds": 900,
    "requires_exact_provider_identity": true,
    "any_post_request_service_start_or_provider_activity_disqualifies": true,
    "start_evidence_disqualifiers": [
      "terminal-evidence",
      "accepted-provider-reaction",
      "provider-review-activity",
      "exact-app-post-request-run-activity"
    ],
    "implicit_decision": "skipped-unavailable",
    "explicit_decision": "blocked-configuration",
    "quota_credit_and_generic_failures_never_qualify": true
  },
  "manual_request_permission": {
    "permission_assurance": "point-in-time-only",
    "request_time_permission": "unproven",
    "permission_aba_excluded": false
  },
  "request_generation_contract": {
    "automatic": {
      "maximum_reservations_per_head": 3,
      "accounting_scope": [
        "repository",
        "pull_request",
        "head_ref_oid"
      ],
      "shared_across_base_retargets": true,
      "reservation_consumes_one_unit": true,
      "post_consumes_additional_unit": false,
      "network_uncertainty_refunds_unit": false,
      "reservation_reuse_or_retry_after_uncertain_post": false,
      "one_post_attempt_per_reservation": true
    },
    "manual": {
      "maximum_exact_requests_per_review_epoch": 64,
      "consumes_automatic_budget": false,
      "requires_exact_body": "@codex review"
    },
    "generation_rules": {
      "one_exact_request_per_generation": true,
      "initial_automatic_generation_requires_local_lanes_terminal": true,
      "additional_automatic_generation_requires_finding_recovery_closure": true,
      "valid_multiple_generations_create_warning": false,
      "same_generation_or_unadmitted_extra_is_not_an_authoritative_generation": true,
      "same_generation_or_unadmitted_extra_forces_request_policy_unknown": true,
      "same_generation_or_unadmitted_extra_disables_request_bound_evidence": true,
      "same_generation_or_unadmitted_extra_does_not_erase_independent_terminal_outcome": true,
      "same_generation_or_unadmitted_extra_creates_warning": false,
      "pending_malformed_or_inconclusive_does_not_authorize_new_automatic_generation": true,
      "same_head_base_retarget_never_resets_or_refunds_budget": true
    }
  },
  "finding_recovery_contract": {
    "applies_when_prior_applicable_finding_exists": true,
    "terminal_clean_can_supply_positive_completion": false,
    "required_sequence": [
      "finding",
      "proved-closure",
      "new-request-generation",
      "later-current-request-reaction"
    ],
    "inline_closure": {
      "authority": "final-direct-graphql-thread-read",
      "required_is_resolved": true,
      "resolved_at_required": false,
      "resolution_observed_at_source": "controller-response-http-date",
      "resolution_observed_at_semantics": "observation-time-lower-bound",
      "provider_resolution_time_claimed": false,
      "addressed_command_required": false,
      "closure_observation_http_date_strictly_after_finding": true,
      "closure_observation_http_date_strictly_before_new_request": true
    },
    "top_level_closure": {
      "exact_body_template": "/codex-gate addressed <finding.html_url>",
      "finding_url_field": "finding.html_url",
      "extra_prefix_suffix_or_whitespace_allowed": false,
      "unedited_required": true,
      "stable_actor_required": true,
      "actor_minimum_repository_permission": "write",
      "accepted_repository_permissions": [
        "write",
        "maintain",
        "admin"
      ],
      "addressed_created_at_strictly_after_finding": true,
      "addressed_created_at_strictly_before_new_request": true
    },
    "new_request": {
      "must_be_new_generation": true,
      "must_be_strictly_after_every_required_closure": true,
      "must_bind_same_current_review_epoch": true
    },
    "later_clean": {
      "accepted_kinds": [
        "current-request-reaction"
      ],
      "must_bind_new_request_generation": true,
      "semantic_time_strictly_after_new_request": true
    }
  },
  "point_in_time_contract": {
    "freshness_assurance": "point-in-time",
    "requires_final_reread": true,
    "public_server_time_encoding": "strict-utc-server-time",
    "strict_utc_pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$",
    "http_date_is_normalized_before_publication": true,
    "proves_continuous_scope_stability": false,
    "proves_no_intermediate_aba": false
  },
  "status_target_mode_contract": {
    "input_name": "status-target-mode",
    "required": true,
    "has_default": false,
    "accepted_values": [
      "head",
      "test-merge-with-head-sentinel"
    ],
    "caller_must_supply_exact_value": true,
    "joey_tools_production_caller": {
      "mode": "test-merge-with-head-sentinel",
      "literal_hardcoded": true,
      "variable_or_expression_forbidden": true
    }
  },
  "status_target_schema": {
    "closed": true,
    "discriminator": "mode",
    "required_fields": [
      "context",
      "mode",
      "live_base_ref_tip",
      "head_ref_oid",
      "pr_merge_base",
      "potential_merge_commit_oid",
      "potential_merge_commit_tree_oid",
      "potential_merge_commit_parent_oids",
      "merge_ref_oid",
      "potential_target_state",
      "head_sentinel_state",
      "validation_receipt"
    ],
    "context": "codex/github-review-gate",
    "mode_values": [
      "head",
      "test-merge-with-head-sentinel"
    ],
    "oid_type": "lowercase-git-oid",
    "oid_pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
    "head_sentinel_state_semantics": "pre-publication-point-in-time-observation",
    "decision_to_write_projection_is_separate": true,
    "variants": {
      "head": {
        "potential_target_state": "not-applicable",
        "potential_fields_must_be_null": [
          "potential_merge_commit_oid",
          "potential_merge_commit_tree_oid",
          "potential_merge_commit_parent_oids",
          "merge_ref_oid"
        ],
        "head_sentinel_state_values": [
          "absent",
          "pending",
          "failure",
          "error"
        ],
        "validation_requirements": {
          "pr_state": "OPEN",
          "pr_merged": false,
          "pr_merged_at": null,
          "pre_post_scope_stable": true,
          "head_ref_oid_equals_review_epoch_head_ref_oid": true,
          "potential_merge_validation_not_applicable": true
        },
        "validation_receipt_schema": {
          "closed": true,
          "nullable": false,
          "required_fields": [
            "pre",
            "post"
          ],
          "observation_required_fields": [
            "observed_http_date",
            "pr_state",
            "pr_merged",
            "pr_merged_at",
            "live_base_ref_tip",
            "head_ref_oid",
            "pr_merge_base"
          ],
          "stable_projection_fields": [
            "pr_state",
            "pr_merged",
            "pr_merged_at",
            "live_base_ref_tip",
            "head_ref_oid",
            "pr_merge_base"
          ],
          "post_http_date_strictly_after_pre": true,
          "observed_http_date_type": "strict-utc-server-time",
          "validated_pre_post_type_preserving_equal": true
        }
      },
      "test-merge-with-head-sentinel": {
        "potential_target_state_values": [
          "validated",
          "unavailable",
          "invalid",
          "conflicting",
          "stale"
        ],
        "head_sentinel_state_values": [
          "absent",
          "pending",
          "failure",
          "error"
        ],
        "validated_parent_order": [
          "live_base_ref_tip",
          "head_ref_oid"
        ],
        "potential_fields_nullable_unless_validated": [
          "potential_merge_commit_oid",
          "potential_merge_commit_tree_oid",
          "potential_merge_commit_parent_oids",
          "merge_ref_oid"
        ],
        "target_state_relation": {
          "validated": {
            "potential_fields": "all-non-null",
            "validation_receipt": "non-null"
          },
          "unavailable": {
            "potential_fields": "all-null",
            "validation_receipt": null
          },
          "invalid": {
            "potential_fields": "all-null",
            "validation_receipt": null
          },
          "conflicting": {
            "potential_fields": "all-null",
            "validation_receipt": null
          },
          "stale": {
            "potential_fields": "all-null",
            "validation_receipt": null
          }
        },
        "validation_requirements": {
          "pr_state": "OPEN",
          "pr_merged": false,
          "pr_merged_at": null,
          "mergeable": "MERGEABLE",
          "potential_merge_commit_required": true,
          "potential_merge_commit_oid_distinct_from_live_base_ref_tip": true,
          "potential_merge_commit_oid_distinct_from_head_ref_oid": true,
          "potential_merge_commit_parent_count": 2,
          "potential_merge_commit_parents_exact_order": [
            "live_base_ref_tip",
            "head_ref_oid"
          ],
          "merge_ref_oid_equals_potential_merge_commit_oid": true,
          "pre_post_scope_and_tree_stable": true
        },
        "validation_receipt_schema": {
          "closed": true,
          "nullable_unless_target_state_validated": true,
          "required_fields": [
            "pre",
            "post"
          ],
          "observation_required_fields": [
            "observed_http_date",
            "pr_state",
            "pr_merged",
            "pr_merged_at",
            "mergeable",
            "live_base_ref_tip",
            "head_ref_oid",
            "pr_merge_base",
            "potential_merge_commit_oid",
            "potential_merge_commit_tree_oid",
            "potential_merge_commit_parent_oids",
            "merge_ref_oid"
          ],
          "stable_projection_fields": [
            "pr_state",
            "pr_merged",
            "pr_merged_at",
            "mergeable",
            "live_base_ref_tip",
            "head_ref_oid",
            "pr_merge_base",
            "potential_merge_commit_oid",
            "potential_merge_commit_tree_oid",
            "potential_merge_commit_parent_oids",
            "merge_ref_oid"
          ],
          "post_http_date_strictly_after_pre": true,
          "observed_http_date_type": "strict-utc-server-time",
          "validated_pre_post_type_preserving_equal": true
        }
      }
    }
  },
  "status_publication_contract": {
    "context": "codex/github-review-gate",
    "mode_required": true,
    "has_default": false,
    "mode_values": [
      "head",
      "test-merge-with-head-sentinel"
    ],
    "head_success_forbidden": true,
    "terminal_verdict_requires_validated_potential_merge": true,
    "terminal_success_requires_validated_potential_merge": true,
    "terminal_decision_requires_observed_head_state_not_success": true,
    "report_head_sentinel_state_is_pre_publication_observed_state": true,
    "publication_plan_must_not_be_projected_back_into_observed_state": true,
    "pre_epoch_selected_blocker_has_no_status_target_and_writes_nothing": true,
    "variants": {
